# =============================================================================
# .env.example — DataOps Pipeline WebCraw
# =============================================================================
# Hướng dẫn:
#   1. Copy file này thành .env ở root repo:
#        cp .env.example .env
#   2. Điền các giá trị thực vào .env (KHÔNG commit .env lên git).
#   3. Khi chạy trên WSL với Docker Compose, đảm bảo .env nằm cùng cấp với
#      thư mục infra_webcraw/ (tức là root của repo).
#
# Lệnh khởi động:
#   cd infra_webcraw
#   docker compose -f docker_compose.yml up -d --build
# =============================================================================


# ── MinIO (Object Storage — Bronze/Silver Parquet) ────────────────────────────

# Host:Port của MinIO — trong Docker dùng tên service, local dùng localhost
# Docker: S3_ENDPOINT=http://minio:9000
# WSL local: S3_ENDPOINT=http://localhost:9000
S3_ENDPOINT=http://minio:9000

# Credentials — phải khớp với MINIO_ROOT_USER / MINIO_ROOT_PASSWORD bên dưới
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin_secure_123@#

# Credentials riêng của MinIO server (đọc bởi container minio)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secure_123@#

# Tên bucket chứa toàn bộ lakehouse (bronze/silver/gold layers)
# Bucket này được tạo tự động bởi pipeline nếu chưa tồn tại
LAKEHOUSE_BUCKET=lakehouse

# Base path S3 dùng xuyên suốt pipeline
# Giá trị phải khớp với tên bucket ở trên: s3://<LAKEHOUSE_BUCKET>
LAKEHOUSE_BASE_PATH=s3://lakehouse


# ── PostgreSQL (Serving layer — staging + normalized tables) ──────────────────

# Docker: POSTGRES_HOST=postgres-local  (tên service trong docker_compose.yml)
# WSL local: POSTGRES_HOST=localhost
POSTGRES_HOST=postgres-local
POSTGRES_PORT=5432
POSTGRES_DB=dataops_webcraw
POSTGRES_USER=postgres@user
POSTGRES_PASSWORD=password@123


# ── Prefect (Orchestration) ───────────────────────────────────────────────────

# Docker: trỏ vào service prefect-server
# WSL local: PREFECT_API_URL=http://localhost:4200/api
PREFECT_API_URL=http://prefect-server:4200/api


# ── Pipeline runtime ──────────────────────────────────────────────────────────

# Môi trường chạy: dev | staging | prod
PIPELINE_ENV=prod

# Python path — được set sẵn trong docker_compose.yml, giữ ở đây để local run
PYTHONPATH=/app
PYTHONUNBUFFERED=1
